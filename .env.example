# Local development settings for the Klaw supervisor (copy to .env).
# Running from a pip install instead? `klaw-supervisor start` needs none of this.

KLAW_ENV=development
# Signs dashboard sessions. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=sqlite+aiosqlite:///./data/klaw.db
EVENT_BUS=memory

# Local dev account (python -m klaw_supervisor.seed)
DEV_USER_EMAIL=dev@klaw.local
DEV_SESSION_TOKEN=change-me

# Dashboards allowed to call this supervisor
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://klaw-supervisor.vercel.app

# Optional: output review and the supervisor chat
SUPERVISOR_LLM_PROVIDER=none
GEMINI_API_KEY=
SUPERVISOR_MODEL=gemini-3.5-flash
SUPERVISOR_FAST_MODEL=gemini-3.5-flash-lite

# Optional: Google sign-in (comma-separated OAuth client IDs)
GOOGLE_CLIENT_IDS=

# SDK / scripts
KLAW_API_URL=http://127.0.0.1:8000
KLAW_API_KEY=
