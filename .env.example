# ---------------------------------------------------------------------------
# Reliability - example environment file.
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core backend -----------------------------------------------------------
RELIABILITY_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Secret used to sign dashboard session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-value

# --- Database ---------------------------------------------------------------
# Default: local SQLite file, no install required.
# For Postgres (e.g. via docker/docker-compose.yml):
#   DATABASE_URL=postgresql+asyncpg://reliability:reliability@localhost:5432/reliability
DATABASE_URL=sqlite+aiosqlite:///./data/reliability.db

# --- Event bus --------------------------------------------------------------
# "memory" runs an in-process pub/sub bus (single backend process, no install).
# "redis" fans out across processes and requires REDIS_URL.
EVENT_BUS=memory
REDIS_URL=redis://localhost:6379/0

# --- Local development user -------------------------------------------------
# Seeded by `python -m app.seed` (run from backend/). The dev session token is
# what the dashboard authenticates with locally, standing in for a login flow.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DEV_USER_EMAIL=dev@reliability.local
DEV_SESSION_TOKEN=change-me-generate-a-random-value

# --- Execution liveness -----------------------------------------------------
# Silence (no events AND no control polls) after which a running execution is
# presumed dead and closed as failed. Must exceed the SDK's poll interval.
STALE_EXECUTION_SECONDS=180

# --- Supervisor LLM evaluator (OPTIONAL) ------------------------------------
# Deterministic detection, incidents and execution control all work with no key
# at all. These only enable model-written diagnosis and the supervisor chat.
#
# Provider: gemini | openai | anthropic | fake | none
SUPERVISOR_LLM_PROVIDER=none
SUPERVISOR_MODEL=gemini-2.0-flash
# Put the key here in your local .env. Never paste an API key into a chat.
SUPERVISOR_LLM_API_KEY=
# Optional override for OpenAI-compatible gateways
SUPERVISOR_LLM_BASE_URL=

# --- Demo agents (OPTIONAL) -------------------------------------------------
# The bundled demo agents are deterministic and need no key. Set this only if
# you later wire a real LLM-powered demo agent.
DEMO_AGENT_API_KEY=

# --- SDK (used by demo/ and your own agents) --------------------------------
# RELIABILITY_API_KEY is printed once by `python -m app.seed`.
RELIABILITY_API_URL=http://127.0.0.1:8000
RELIABILITY_API_KEY=
